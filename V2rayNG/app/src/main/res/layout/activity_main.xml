<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main"
    android:fitsSystemWindows="false">

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:paddingBottom="0dp"
            android:fitsSystemWindows="false">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="invisible"
                app:indicatorColor="@color/colorWhite" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                app:cardBackgroundColor="@color/vpn_card_white"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp"
                app:strokeColor="@android:color/transparent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="88dp">

                    <!-- Header: VPN title only (minimal, premium) -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="@string/vpn_header_title"
                        android:textColor="@color/md_theme_onBackground"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <!-- Selected server (above connect button) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/country_selector"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/card_gradient_end"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp"
                        app:rippleColor="@color/accent_primary">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="12dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <TextView
                                android:id="@+id/tv_country_flag"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:gravity="center"
                                android:textSize="20sp"
                                android:text="🌍" />

                            <TextView
                                android:id="@+id/tv_country_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="12dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/vpn_select_location"
                                android:textColor="@color/md_theme_onBackground"
                                android:textSize="16sp" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_chevron_down_24dp"
                                android:contentDescription="@string/vpn_choose_country" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Power button with ring -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp">

                        <!-- Outer glow ring -->
                        <View
                            android:layout_width="180dp"
                            android:layout_height="180dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_power_button_ring"
                            android:alpha="0.3" />

                        <!-- Middle ring -->
                        <View
                            android:layout_width="160dp"
                            android:layout_height="160dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_power_button_ring"
                            android:alpha="0.5" />

                        <!-- Power button -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="center"
                            app:cardCornerRadius="70dp"
                            app:cardElevation="12dp"
                            app:strokeWidth="0dp">
                            <ImageButton
                                android:id="@+id/btn_power"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_gradient_button"
                                android:contentDescription="@string/action_stop_service"
                                android:padding="32dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_play_24dp"
                                android:tint="@android:color/white" />
                        </com.google.android.material.card.MaterialCardView>
                    </FrameLayout>

                    <!-- Status: dot + Connected/Connecting/Disconnected -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="4dp"
                        app:strokeWidth="0dp"
                        app:cardBackgroundColor="@color/card_gradient_end">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp">

                            <View
                                android:id="@+id/status_dot"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/bg_status_dot_connected" />

                            <TextView
                                android:id="@+id/tv_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/vpn_disconnected"
                                android:textColor="@color/md_theme_onBackground"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.02" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Speed section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="@string/vpn_speed"
                        android:textColor="@color/vpn_speed_label"
                        android:textSize="12sp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:cardBackgroundColor="@color/card_gradient_end"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="6dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingVertical="16dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vpn_download"
                                    android:textColor="@color/vpn_speed_label"
                                    android:textSize="11sp"
                                    android:textAllCaps="true"
                                    android:letterSpacing="0.05" />
                                <TextView
                                    android:id="@+id/tv_download_speed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="@color/md_theme_onBackground"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.02" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:background="@color/divider_color_light" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/vpn_upload"
                                    android:textColor="@color/vpn_speed_label"
                                    android:textSize="11sp"
                                    android:textAllCaps="true"
                                    android:letterSpacing="0.05" />
                                <TextView
                                    android:id="@+id/tv_upload_speed"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="@color/md_theme_onBackground"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.02" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="36dp"
                                android:layout_marginHorizontal="8dp"
                                android:background="@color/divider_color_light" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/ping"
                                    android:textColor="@color/vpn_speed_label"
                                    android:textSize="11sp"
                                    android:textAllCaps="true"
                                    android:letterSpacing="0.05" />
                                <TextView
                                    android:id="@+id/tv_ping"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="—"
                                    android:textColor="@color/md_theme_onBackground"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.02" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Hidden: keep ViewPager so GroupServerFragment still loads server data -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/view_pager"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="invisible" />

    <!-- Bottom Navigation: مینیمال، ارتفاع استاندارد 56dp، بدون پس‌زمینه زشت پشت آیکن -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="4dp"
        android:minHeight="@dimen/bottom_nav_height"
        app:itemIconTint="@color/bottom_nav_selector"
        app:itemTextColor="@color/bottom_nav_selector"
        app:itemBackground="@drawable/bg_bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:itemRippleColor="@android:color/transparent"
        app:menu="@menu/bottom_navigation_menu" />
</FrameLayout>
